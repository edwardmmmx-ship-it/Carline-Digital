  <meta name="theme-color" content="#0b2d43">
  <style>
    :root {
      --ink: #0a2639;
      --ink-2: #123a50;
      --paper: #f7f4ed;
      --paper-2: #eee9dd;
      --white: #fffdf8;
      --blue: #0d6692;
      --blue-2: #44a0c8;
      --aqua: #7ec7c0;
      --sand: #d8c8a8;
      --line: rgba(10, 38, 57, .16);
      --muted: #63727a;
      --shadow: 0 30px 80px rgba(5, 31, 48, .16);
      --radius: 28px;
      --ease: cubic-bezier(.2,.75,.25,1);
      --max: 1240px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; background: var(--paper); }
    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: var(--ink);
      background: var(--paper);
      line-height: 1.55;
      overflow-x: hidden;
    }
    body.menu-open { overflow: hidden; }
    img { display: block; width: 100%; }
    a { color: inherit; text-decoration: none; }
    button, input, textarea { font: inherit; }
    button { color: inherit; }
    ::selection { background: var(--aqua); color: var(--ink); }

    .skip-link {
      position: fixed; left: 1rem; top: 1rem; z-index: 9999;
      padding: .7rem 1rem; background: var(--white); border-radius: 999px;
      transform: translateY(-180%); transition: .2s ease;
    }
    .skip-link:focus { transform: none; }

    .progress {
      position: fixed; inset: 0 auto auto 0; height: 3px; width: 0;
      background: linear-gradient(90deg, var(--blue-2), var(--aqua)); z-index: 1200;
    }

    .nav {
      position: fixed; left: 0; right: 0; top: 0; z-index: 1000;
      padding: 18px 24px; transition: .35s var(--ease);
    }
    .nav.scrolled { padding-top: 10px; padding-bottom: 10px; }
    .nav-shell {
      max-width: var(--max); margin: 0 auto; display: flex; align-items: center;
      justify-content: space-between; gap: 20px; padding: 10px 12px 10px 18px;
      border: 1px solid rgba(255,255,255,.14); border-radius: 20px;
      background: rgba(8,36,54,.72); color: white; backdrop-filter: blur(18px);
      box-shadow: 0 10px 40px rgba(0,0,0,.12);
    }
    .brand { display: flex; align-items: center; gap: 11px; font-weight: 850; letter-spacing: -.03em; }
    .brand-mark {
      width: 34px; aspect-ratio: 1; border-radius: 50%;
      border: 2px solid rgba(255,255,255,.85); position: relative;
    }
    .brand-mark::before, .brand-mark::after {
      content: ""; position: absolute; border: 2px solid var(--aqua); border-radius: 50%;
      width: 9px; height: 15px; transform: rotate(42deg);
    }
    .brand-mark::before { left: 5px; top: 6px; }
    .brand-mark::after { right: 5px; bottom: 5px; }
    .brand small { display: block; font-size: .58rem; letter-spacing: .13em; opacity: .72; text-transform: uppercase; margin-top: -2px; }
    .nav-links { display: flex; align-items: center; gap: 4px; }
    .nav-links a {
      padding: 9px 12px; border-radius: 12px; font-size: .87rem; font-weight: 700;
      color: rgba(255,255,255,.72); transition: .25s ease;
    }
    .nav-links a:hover, .nav-links a.active { color: white; background: rgba(255,255,255,.09); }
    .nav-call {
      display: inline-flex; align-items: center; gap: 8px; border-radius: 13px;
      padding: 10px 14px; background: var(--white); color: var(--ink); font-weight: 850; font-size: .88rem;
    }
    .menu-toggle { display: none; background: transparent; border: 0; padding: 10px; cursor: pointer; }
    .menu-toggle span { display: block; width: 24px; height: 2px; background: white; margin: 5px 0; transition: .25s ease; }

    .hero {
      min-height: 92vh; color: white; position: relative; overflow: hidden;
      background: radial-gradient(circle at 73% 23%, rgba(68,160,200,.35), transparent 30%), var(--ink);
      display: grid; align-items: end; padding: 150px 24px 70px;
    }
    .hero::before {
      content: ""; position: absolute; inset: 0 0 0 54%;
      background: linear-gradient(90deg, var(--ink) 0%, rgba(10,38,57,.18) 48%, rgba(10,38,57,.06)),
                  url('https://irp.cdn-website.com//32586392/dms3rep/multi/opt/Sullivan%2BPlumbing%2Band%2BGas%2B3-1152w.jpg') center/cover no-repeat;
      opacity: .82;
    }
    .hero::after {
      content: ""; position: absolute; width: 480px; height: 480px; border: 1px solid rgba(126,199,192,.28);
      border-radius: 50%; right: -120px; top: 5%; box-shadow: inset 0 0 0 80px rgba(126,199,192,.035), inset 0 0 0 160px rgba(126,199,192,.025);
    }
    .hero-grid {
      position: relative; z-index: 2; width: min(var(--max),100%); margin: 0 auto;
      display: grid; grid-template-columns: minmax(0, .94fr) minmax(340px, .55fr); gap: 8vw; align-items: end;
    }
    .eyebrow { display: flex; align-items: center; gap: 10px; font-size: .78rem; letter-spacing: .14em; font-weight: 850; text-transform: uppercase; }
    .eyebrow::before { content: ""; width: 34px; height: 1px; background: currentColor; opacity: .55; }
    h1, h2, h3, p { margin-top: 0; }
    h1 { font-size: clamp(3.4rem, 7vw, 7rem); line-height: .92; letter-spacing: -.07em; margin: 24px 0 28px; max-width: 9.5ch; }
    h1 em { font-style: normal; color: var(--aqua); }
    .hero-lede { font-size: clamp(1.05rem, 1.6vw, 1.35rem); color: rgba(255,255,255,.8); max-width: 640px; }
    .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 34px; }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      min-height: 50px; padding: 0 20px; border-radius: 14px; border: 1px solid transparent;
      font-weight: 850; letter-spacing: -.01em; cursor: pointer; transition: transform .3s var(--ease), box-shadow .3s ease, background .25s ease;
    }
    .btn-primary { background: var(--white); color: var(--ink); box-shadow: 0 12px 28px rgba(0,0,0,.14); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 18px 34px rgba(0,0,0,.2); }
    .btn-ghost { border-color: rgba(255,255,255,.25); color: white; background: rgba(255,255,255,.06); }
    .btn-ghost:hover { background: rgba(255,255,255,.12); }
    .arrow { font-size: 1.2em; transform: translateY(-1px); }

    .hero-proof {
      align-self: end; border-top: 1px solid rgba(255,255,255,.24); padding-top: 24px;
      display: grid; gap: 18px; max-width: 430px; justify-self: end;
    }
    .hero-proof p { margin: 0; color: rgba(255,255,255,.72); }
    .proof-row { display: flex; flex-wrap: wrap; gap: 9px; }
    .proof-pill { padding: 7px 10px; border-radius: 10px; background: rgba(255,255,255,.09); font-size: .78rem; font-weight: 800; }
    .scroll-note { display: flex; align-items: center; gap: 12px; font-size: .75rem; text-transform: uppercase; letter-spacing: .12em; opacity: .62; margin-top: 16px; }
    .scroll-note i { width: 42px; height: 1px; background: currentColor; }

    .ticker { background: var(--aqua); color: var(--ink); border-bottom: 1px solid rgba(10,38,57,.12); overflow: hidden; }
    .ticker-track { display: flex; width: max-content; animation: ticker 30s linear infinite; }
    .ticker-item { padding: 15px 26px; font-weight: 850; font-size: .78rem; letter-spacing: .09em; text-transform: uppercase; display: flex; align-items: center; gap: 24px; }
    .ticker-item::after { content: "•"; opacity: .55; }
    @keyframes ticker { to { transform: translateX(-50%); } }

    .section { padding: 110px 24px; position: relative; }
    .container { width: min(var(--max),100%); margin: 0 auto; }
    .section-head { display: grid; grid-template-columns: .55fr 1.25fr; gap: 8vw; align-items: start; margin-bottom: 62px; }
    .section-kicker { font-size: .76rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 900; color: var(--blue); }
    .section-head h2 { font-size: clamp(2.7rem, 5vw, 5.4rem); line-height: .95; letter-spacing: -.065em; margin: 0; max-width: 11ch; }
    .section-head p { color: var(--muted); font-size: 1.05rem; max-width: 620px; margin-top: 22px; }

    .services { background: var(--white); }
    .service-list { border-top: 1px solid var(--line); }
    .service {
      display: grid; grid-template-columns: 80px 1fr auto; align-items: center; gap: 22px;
      border-bottom: 1px solid var(--line); padding: 23px 0; cursor: pointer; transition: .3s var(--ease);
    }
    .service:hover { padding-left: 12px; }
    .service-num { font-size: .75rem; color: var(--muted); font-weight: 850; }
    .service h3 { margin: 0; font-size: clamp(1.45rem, 3vw, 2.55rem); letter-spacing: -.04em; }
    .service-toggle { width: 42px; height: 42px; border: 1px solid var(--line); border-radius: 50%; display: grid; place-items: center; transition: .3s ease; }
    .service[aria-expanded="true"] .service-toggle { transform: rotate(45deg); background: var(--ink); color: white; }
    .service-detail { grid-column: 2 / 4; max-height: 0; overflow: hidden; transition: max-height .45s var(--ease); }
    .service-detail-inner { display: grid; grid-template-columns: 1fr .65fr; gap: 6vw; padding: 4px 0 28px; }
    .service-detail p { color: var(--muted); max-width: 680px; }
    .tags { display: flex; gap: 7px; flex-wrap: wrap; align-content: start; }
    .tag { font-size: .75rem; font-weight: 800; border: 1px solid var(--line); padding: 6px 9px; border-radius: 8px; background: var(--paper); }

    .feature { background: var(--ink); color: white; overflow: hidden; }
    .feature-grid { display: grid; grid-template-columns: .88fr 1fr; gap: 7vw; align-items: center; }
    .feature-copy h2 { font-size: clamp(3rem, 5.6vw, 5.8rem); line-height: .92; letter-spacing: -.065em; margin: 16px 0 26px; }
    .feature-copy p { color: rgba(255,255,255,.7); max-width: 590px; font-size: 1.05rem; }
    .feature-image-wrap { position: relative; min-height: 640px; }
    .feature-image {
      position: absolute; inset: 0; border-radius: var(--radius); overflow: hidden; background: white; box-shadow: var(--shadow);
    }
    .feature-image img { height: 100%; object-fit: contain; padding: 8%; }
    .feature-image::after { content: "RINNAI INFINITY"; position: absolute; left: -5px; bottom: 22px; font-weight: 950; font-size: clamp(2.4rem, 5vw, 5rem); color: var(--ink); letter-spacing: -.06em; opacity: .07; white-space: nowrap; }
    .feature-points { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); border-top: 1px solid rgba(255,255,255,.15); margin-top: 34px; }
    .feature-point { padding: 18px 20px 18px 0; border-bottom: 1px solid rgba(255,255,255,.15); color: rgba(255,255,255,.72); font-size: .9rem; }
    .feature-point b { display: block; color: white; margin-bottom: 3px; }

    .water { background: var(--paper); }
    .water-grid { display: grid; grid-template-columns: 1.1fr .8fr; gap: 32px; align-items: stretch; }
    .water-visual { border-radius: var(--radius); overflow: hidden; min-height: 660px; position: relative; box-shadow: var(--shadow); }
    .water-visual img { height: 100%; object-fit: cover; }
    .water-visual .caption { position: absolute; inset: auto 18px 18px 18px; padding: 17px 18px; border-radius: 16px; color: white; background: rgba(10,38,57,.75); backdrop-filter: blur(14px); font-size: .86rem; }
    .water-copy { padding: 18px 2vw 18px 3vw; display: flex; flex-direction: column; justify-content: center; }
    .water-copy h2 { font-size: clamp(2.9rem, 5vw, 5.2rem); line-height: .95; letter-spacing: -.06em; margin: 15px 0 28px; }
    .water-copy > p { color: var(--muted); font-size: 1.03rem; }
    .mini-list { margin-top: 30px; border-top: 1px solid var(--line); }
    .mini-item { display: grid; grid-template-columns: 40px 1fr; gap: 16px; padding: 19px 0; border-bottom: 1px solid var(--line); }
    .mini-item strong { font-size: .78rem; color: var(--blue); }
    .mini-item b { display: block; margin-bottom: 4px; }
    .mini-item span { color: var(--muted); font-size: .88rem; }

    .about { background: var(--white); overflow: hidden; }
    .about-grid { display: grid; grid-template-columns: .82fr 1.18fr; gap: 8vw; align-items: start; }
    .about-sticky { position: sticky; top: 110px; }
    .about-sticky h2 { font-size: clamp(3.1rem, 5vw, 5.7rem); line-height: .94; letter-spacing: -.065em; margin: 14px 0 28px; }
    .about-sticky p { color: var(--muted); font-size: 1.04rem; }
    .principles { counter-reset: principle; border-top: 1px solid var(--line); }
    .principle { counter-increment: principle; padding: 34px 0; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 64px 1fr; gap: 22px; }
    .principle::before { content: "0" counter(principle); color: var(--blue); font-size: .76rem; font-weight: 900; }
    .principle h3 { font-size: 1.55rem; letter-spacing: -.035em; margin-bottom: 8px; }
    .principle p { color: var(--muted); margin: 0; max-width: 620px; }

    .reviews { background: var(--ink); color: white; }
    .reviews .section-kicker { color: var(--aqua); }
    .reviews-head { display: flex; justify-content: space-between; gap: 24px; align-items: end; margin-bottom: 42px; }
    .reviews-head h2 { font-size: clamp(2.8rem, 5vw, 5.2rem); letter-spacing: -.06em; line-height: .95; margin: 0; max-width: 10ch; }
    .review-controls { display: flex; gap: 8px; }
    .review-controls button { width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(255,255,255,.2); background: transparent; color: white; cursor: pointer; }
    .review-window { overflow: hidden; }
    .review-track { display: flex; transition: transform .55s var(--ease); }
    .review-slide { flex: 0 0 100%; padding: 24px 0 8px; }
    .review-quote { font-size: clamp(1.9rem, 4vw, 4rem); line-height: 1.08; letter-spacing: -.045em; max-width: 1050px; margin-bottom: 38px; }
    .review-meta { color: rgba(255,255,255,.58); font-size: .82rem; text-transform: uppercase; letter-spacing: .1em; }
    .review-dots { display: flex; gap: 7px; margin-top: 32px; }
    .review-dot { width: 44px; height: 3px; background: rgba(255,255,255,.16); border: 0; padding: 0; cursor: pointer; }
    .review-dot.active { background: var(--aqua); }

    .contact { padding-bottom: 0; background: var(--paper); }
    .contact-card {
      background: var(--blue); color: white; border-radius: 34px; padding: clamp(30px, 6vw, 78px);
      position: relative; overflow: hidden; box-shadow: var(--shadow);
    }
    .contact-card::before { content: ""; position: absolute; width: 450px; height: 450px; border-radius: 50%; border: 1px solid rgba(255,255,255,.14); right: -160px; top: -210px; box-shadow: inset 0 0 0 80px rgba(255,255,255,.03), inset 0 0 0 160px rgba(255,255,255,.025); }
    .contact-grid { display: grid; grid-template-columns: 1.15fr .65fr; gap: 8vw; position: relative; z-index: 1; }
    .contact-card h2 { font-size: clamp(3.4rem, 6.5vw, 6.8rem); line-height: .9; letter-spacing: -.07em; margin: 14px 0 26px; }
    .contact-card p { color: rgba(255,255,255,.72); max-width: 610px; font-size: 1.06rem; }
    .contact-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
    .contact-info { align-self: end; border-top: 1px solid rgba(255,255,255,.23); }
    .contact-info div { padding: 18px 0; border-bottom: 1px solid rgba(255,255,255,.23); }
    .contact-info span { display: block; font-size: .72rem; text-transform: uppercase; letter-spacing: .12em; opacity: .58; margin-bottom: 4px; }
    .contact-info strong { font-size: 1.08rem; }

    footer { background: var(--paper); padding: 50px 24px 32px; }
    .footer-grid { width: min(var(--max),100%); margin: 0 auto; display: grid; grid-template-columns: 1fr auto; gap: 28px; align-items: end; }
    .footer-brand { font-size: clamp(2rem, 4vw, 4rem); font-weight: 950; letter-spacing: -.065em; }
    .footer-note { color: var(--muted); max-width: 540px; font-size: .84rem; margin-top: 8px; }
    .footer-links { display: flex; flex-wrap: wrap; gap: 10px 18px; justify-content: flex-end; font-size: .83rem; font-weight: 780; }
    .footer-bottom { width: min(var(--max),100%); margin: 30px auto 0; padding-top: 18px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 20px; color: var(--muted); font-size: .76rem; }

    .mobile-call { display: none; }
    .reveal { opacity: 0; transform: translateY(22px); transition: opacity .75s var(--ease), transform .75s var(--ease); }
    .reveal.in { opacity: 1; transform: none; }

    @media (max-width: 980px) {
      .nav-links { display: none; }
      .menu-toggle { display: block; }
      .nav-call { display: none; }
      .nav-links.open {
        display: flex; position: fixed; inset: 84px 18px auto; padding: 18px; flex-direction: column; align-items: stretch;
        background: var(--ink); border: 1px solid rgba(255,255,255,.12); border-radius: 20px; box-shadow: var(--shadow);
      }
      .nav-links.open a { padding: 14px; font-size: 1rem; }
      .hero { min-height: 860px; }
      .hero::before { inset: 42% 0 0 22%; opacity: .55; }
      .hero-grid { grid-template-columns: 1fr; gap: 56px; }
      .hero-proof { justify-self: start; }
      .section-head { grid-template-columns: 1fr; gap: 18px; }
      .feature-grid, .water-grid, .about-grid, .contact-grid { grid-template-columns: 1fr; }
      .feature-image-wrap { min-height: 500px; }
      .water-visual { min-height: 500px; }
      .about-sticky { position: static; }
      .footer-grid { grid-template-columns: 1fr; }
      .footer-links { justify-content: flex-start; }
    }

    @media (max-width: 680px) {
      .nav { padding: 10px; }
      .nav-shell { border-radius: 16px; }
      .brand { font-size: .92rem; }
      .hero { min-height: 790px; padding: 118px 20px 42px; }
      .hero::before { inset: 44% 0 0 0; }
      .hero h1 { font-size: clamp(3.2rem, 17vw, 5.2rem); }
      .hero-proof { display: none; }
      .section { padding: 78px 20px; }
      .service { grid-template-columns: 48px 1fr auto; gap: 12px; }
      .service-detail { grid-column: 1 / 4; }
      .service-detail-inner { grid-template-columns: 1fr; gap: 12px; }
      .feature-image-wrap { min-height: 420px; }
      .feature-points { grid-template-columns: 1fr; }
      .water-visual { min-height: 460px; }
      .principle { grid-template-columns: 42px 1fr; }
      .reviews-head { align-items: start; flex-direction: column; }
      .contact-card { border-radius: 22px; }
      .footer-bottom { flex-direction: column; }
      .mobile-call {
        display: flex; position: fixed; z-index: 900; left: 14px; right: 14px; bottom: 14px; min-height: 52px;
        background: var(--white); color: var(--ink); border-radius: 16px; box-shadow: 0 16px 50px rgba(0,0,0,.22);
        align-items: center; justify-content: center; font-weight: 900;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation: none !important; transition-duration: .01ms !important; }
      .reveal { opacity: 1; transform: none; }
    }
  </style>
</head>
