<!doctype html>
<html lang="en-NZ">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Onehunga Plumbers | Plumbing, Roofing, Drainlaying & Gasfitting Auckland</title>
  <meta name="description" content="Onehunga Plumbers provides 24/7 plumbing, roofing, drainlaying and gasfitting services across Auckland for residential and commercial properties. Call 0800 8 ONEHUNGA.">
  <meta name="theme-color" content="#11161a">
  <meta property="og:title" content="Onehunga Plumbers | Auckland Wide">
  <meta property="og:description" content="Plumbing, roofing, drainlaying and gasfitting across Auckland, with 24/7 emergency availability and a 12-month workmanship guarantee.">
  <meta property="og:type" content="website">
  <style>
    :root {
      --ink: #11161a;
      --ink-soft: #20282d;
      --paper: #f4f1e9;
      --paper-2: #ebe6da;
      --white: #fffdf8;
      --yellow: #f7c900;
      --yellow-2: #ffd928;
      --line: rgba(17,22,26,.16);
      --muted: #657078;
      --radius: 18px;
      --shadow: 0 18px 50px rgba(17,22,26,.16);
      --serif: Georgia, 'Times New Roman', serif;
      --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: var(--sans);
      color: var(--ink);
      background: var(--paper);
      line-height: 1.55;
      overflow-x: hidden;
    }
    img { max-width: 100%; display: block; }
    a { color: inherit; }
    button, input, textarea { font: inherit; }
    button { cursor: pointer; }
    ::selection { background: var(--yellow); color: var(--ink); }
    .skip-link {
      position: fixed; left: 1rem; top: -5rem; z-index: 9999;
      background: var(--yellow); color: var(--ink); padding: .8rem 1rem; font-weight: 800;
    }
    .skip-link:focus { top: 1rem; }
    .wrap { width: min(1180px, calc(100% - 40px)); margin-inline: auto; }
    .eyebrow {
      display: inline-flex; align-items: center; gap: .65rem;
      font-size: .74rem; font-weight: 900; letter-spacing: .16em; text-transform: uppercase;
    }
    .eyebrow::before { content: ''; width: 26px; height: 3px; background: var(--yellow); }
    .display {
      font-family: var(--serif); font-weight: 700; letter-spacing: -.055em; line-height: .93;
      margin: 0;
    }
    .section-title { font-size: clamp(2.6rem, 6vw, 5.9rem); max-width: 10ch; }
    .section-copy { font-size: clamp(1.05rem, 1.6vw, 1.28rem); color: #49535a; max-width: 62ch; }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: .75rem;
      min-height: 54px; padding: 0 1.25rem; border: 1px solid transparent; text-decoration: none;
      font-size: .86rem; font-weight: 900; letter-spacing: .06em; text-transform: uppercase;
      transition: transform .22s ease, background .22s ease, border-color .22s ease, color .22s ease;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn-primary { background: var(--yellow); color: var(--ink); }
    .btn-primary:hover { background: var(--yellow-2); }
    .btn-dark { background: var(--ink); color: var(--white); }
    .btn-ghost { border-color: rgba(255,255,255,.32); color: var(--white); }
    .btn-ghost:hover { border-color: var(--yellow); color: var(--yellow); }
    .arrow { font-size: 1.15rem; line-height: 1; transition: transform .2s ease; }
    .btn:hover .arrow { transform: translateX(4px); }

    /* Header */
    .site-header {
      position: fixed; inset: 0 0 auto 0; z-index: 1000; height: 78px;
      display: flex; align-items: center; transition: background .25s ease, box-shadow .25s ease, height .25s ease;
    }
    .site-header.scrolled { background: rgba(17,22,26,.96); box-shadow: 0 10px 30px rgba(0,0,0,.16); height: 68px; }
    .nav { width: min(1260px, calc(100% - 36px)); margin: auto; display: flex; align-items: center; gap: 2rem; }
    .brand { display: inline-flex; align-items: center; gap: .8rem; text-decoration: none; color: white; min-width: max-content; }
    .brand-mark {
      width: 39px; aspect-ratio: 1; background: var(--yellow); color: var(--ink);
      display: grid; place-items: center; font-weight: 950; font-size: 1.02rem; letter-spacing: -.06em;
      clip-path: polygon(10% 0,100% 0,100% 78%,80% 100%,0 100%,0 10%);
    }
    .brand-copy { display: grid; line-height: .95; font-size: .86rem; font-weight: 950; text-transform: uppercase; letter-spacing: .06em; }
    .brand-copy span:last-child { color: var(--yellow); }
    .nav-links { margin-left: auto; display: flex; align-items: center; gap: clamp(.85rem, 2vw, 1.7rem); }
    .nav-links a { color: rgba(255,255,255,.76); text-decoration: none; font-size: .78rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; position: relative; }
    .nav-links a::after { content:''; position:absolute; left:0; bottom:-7px; width:100%; height:2px; background:var(--yellow); transform:scaleX(0); transform-origin:left; transition:.2s; }
    .nav-links a:hover, .nav-links a.active { color: white; }
    .nav-links a:hover::after, .nav-links a.active::after { transform: scaleX(1); }
    .header-call { margin-left: .5rem; }
    .menu-toggle { margin-left: auto; display: none; width: 45px; height: 45px; border: 1px solid rgba(255,255,255,.25); background: transparent; color:white; }

    /* Hero */
    .hero {
      min-height: 100svh; position: relative; display: grid; align-items: end; overflow: hidden;
      background: var(--ink); color: var(--white); padding: 140px 0 70px;
    }
    .hero::before {
      content:''; position:absolute; inset:0;
      background:
        linear-gradient(90deg, rgba(17,22,26,.98) 0%, rgba(17,22,26,.92) 41%, rgba(17,22,26,.28) 76%, rgba(17,22,26,.58) 100%),
        url('https://www.onehungaplumbers.com/images/onehunga-plumbers.jpg') center right / min(50vw,760px) auto no-repeat;
      transform: scale(1.01);
    }
    .hero::after {
      content:''; position:absolute; inset:auto 0 0 0; height:1px; background:rgba(255,255,255,.18);
    }
    .hero-grid { position: relative; z-index: 2; display:grid; grid-template-columns: 1.35fr .65fr; gap: 5vw; align-items:end; }
    .hero h1 { font-size: clamp(4.2rem, 10.5vw, 10.5rem); max-width: 7ch; }
    .hero h1 em { color: var(--yellow); font-style: normal; }
    .hero-intro { max-width: 55ch; font-size: clamp(1.08rem, 1.6vw, 1.3rem); color: rgba(255,255,255,.78); margin: 1.8rem 0 2.2rem; }
    .hero-actions { display:flex; gap:.7rem; flex-wrap:wrap; }
    .hero-aside { align-self:end; padding-bottom: .3rem; }
    .availability {
      border-top: 1px solid rgba(255,255,255,.28); padding-top: 1.3rem; display:grid; gap:1rem;
    }
    .availability strong { font-family: var(--serif); font-size: 2.25rem; letter-spacing:-.04em; line-height:1; }
    .availability p { margin:0; color:rgba(255,255,255,.67); }
    .hero-tags { display:flex; flex-wrap:wrap; gap:.45rem; margin-top:1.3rem; }
    .hero-tags span { border:1px solid rgba(255,255,255,.22); padding:.45rem .65rem; font-size:.67rem; font-weight:800; text-transform:uppercase; letter-spacing:.08em; }
    .scroll-cue { position:absolute; z-index:3; right:2.5vw; bottom:1.5rem; writing-mode:vertical-rl; color:rgba(255,255,255,.42); text-transform:uppercase; letter-spacing:.18em; font-size:.62rem; }

    /* Signal bar */
    .signal-bar { background: var(--yellow); border-bottom:1px solid rgba(0,0,0,.12); }
    .signal-grid { display:grid; grid-template-columns: repeat(4,1fr); }
    .signal { padding: 1.15rem 1.25rem; border-left:1px solid rgba(0,0,0,.12); }
    .signal:last-child { border-right:1px solid rgba(0,0,0,.12); }
    .signal b { display:block; text-transform:uppercase; letter-spacing:.06em; font-size:.8rem; }
    .signal small { display:block; margin-top:.15rem; color:rgba(17,22,26,.68); }

    /* Intro */
    .intro { padding: clamp(90px, 12vw, 160px) 0; position:relative; }
    .intro-grid { display:grid; grid-template-columns: .7fr 1.3fr; gap: 7vw; align-items:start; }
    .intro .section-title { max-width: 9ch; }
    .intro-copy { padding-top:1rem; }
    .intro-copy p:first-child { font-family:var(--serif); font-size:clamp(1.65rem,3vw,2.65rem); line-height:1.15; letter-spacing:-.035em; margin-top:0; color:var(--ink); }
    .intro-copy p { color:#4d575d; max-width:62ch; }
    .inline-proof { margin-top:2rem; display:grid; grid-template-columns:repeat(2,1fr); border-top:1px solid var(--line); }
    .proof { padding:1.4rem 1.4rem 0 0; }
    .proof + .proof { border-left:1px solid var(--line); padding-left:1.4rem; }
    .proof strong { font-family:var(--serif); font-size:2rem; display:block; line-height:1.05; }
    .proof span { color:var(--muted); font-size:.83rem; }

    /* Services */
    .services { background: var(--ink); color:var(--white); padding: clamp(90px, 10vw, 140px) 0; }
    .services-head { display:flex; justify-content:space-between; gap:2rem; align-items:end; margin-bottom:4rem; }
    .services-head .section-copy { color:rgba(255,255,255,.62); }
    .services-list { border-top:1px solid rgba(255,255,255,.18); }
    .service-row { position:relative; border-bottom:1px solid rgba(255,255,255,.18); overflow:hidden; }
    .service-trigger {
      width:100%; background:transparent; border:0; color:inherit; text-align:left; padding:2rem 0;
      display:grid; grid-template-columns: 70px 1fr auto; align-items:center; gap:1.2rem;
    }
    .service-num { color:var(--yellow); font-weight:900; font-size:.76rem; letter-spacing:.1em; }
    .service-name { font-family:var(--serif); font-size:clamp(2rem,5vw,5.4rem); letter-spacing:-.05em; line-height:1; }
    .service-icon { width:46px;height:46px;border:1px solid rgba(255,255,255,.25);display:grid;place-items:center;font-size:1.35rem; transition:transform .3s ease,background .3s,color .3s; }
    .service-row.open .service-icon { transform:rotate(45deg); background:var(--yellow); color:var(--ink); }
    .service-detail { max-height:0; transition:max-height .5s ease; }
    .service-row.open .service-detail { max-height:520px; }
    .service-detail-grid { display:grid; grid-template-columns:.8fr 1.2fr; gap:4vw; padding:0 0 2.5rem 70px; }
    .service-detail img { width:100%; aspect-ratio:16/9; object-fit:cover; filter:saturate(.8) contrast(1.05); }
    .service-detail p { margin-top:0; color:rgba(255,255,255,.68); max-width:58ch; }
    .service-detail ul { columns:2; margin:1.3rem 0 0; padding:0; list-style:none; }
    .service-detail li { break-inside:avoid; padding:.55rem 0 .55rem 1.25rem; position:relative; color:rgba(255,255,255,.85); }
    .service-detail li::before { content:'—'; position:absolute; left:0; color:var(--yellow); }

    /* History */
    .history { padding:clamp(90px,11vw,150px) 0; overflow:hidden; }
    .history-grid { display:grid; grid-template-columns:.85fr 1.15fr; gap:7vw; }
    .history-sticky { position:sticky; top:120px; align-self:start; }
    .history-sticky .section-copy { margin-top:1.5rem; }
    .timeline { border-left:1px solid var(--line); }
    .timeline-item { position:relative; padding:0 0 4.2rem 2.6rem; }
    .timeline-item::before { content:''; position:absolute; left:-6px; top:.45rem; width:11px;height:11px;background:var(--yellow);border:3px solid var(--paper);box-shadow:0 0 0 1px var(--ink); }
    .timeline-year { font-family:var(--serif); font-size:clamp(2.7rem,5vw,5rem); line-height:1; letter-spacing:-.05em; }
    .timeline-item h3 { margin:.7rem 0 .45rem; font-size:1.1rem; text-transform:uppercase; letter-spacing:.05em; }
    .timeline-item p { color:var(--muted); max-width:54ch; margin:0; }
    .history-note { background:var(--yellow); padding:1.6rem; margin-top:.7rem; font-family:var(--serif); font-size:1.45rem; line-height:1.2; letter-spacing:-.025em; }

    /* Guarantee */
    .guarantee { background:var(--paper-2); padding:0; }
    .guarantee-grid { display:grid; grid-template-columns:1fr 1fr; min-height:650px; }
    .guarantee-visual { position:relative; overflow:hidden; background:#d8d2c4; }
    .guarantee-visual img { width:100%;height:100%;object-fit:cover;filter:grayscale(.15) saturate(.8); }
    .guarantee-visual::after { content:'12'; position:absolute; right:-.05em; bottom:-.18em; font-family:var(--serif); font-weight:700; font-size:clamp(14rem,26vw,28rem); line-height:1; color:rgba(247,201,0,.86); mix-blend-mode:multiply; }
    .guarantee-copy { padding:clamp(60px,9vw,120px); display:flex; flex-direction:column; justify-content:center; }
    .guarantee-copy h2 { font-size:clamp(3rem,6vw,6.4rem); max-width:7ch; }
    .guarantee-copy p { max-width:52ch; color:#4f585d; }
    .guarantee-copy .big-line { font-family:var(--serif); font-size:1.6rem; color:var(--ink); border-top:1px solid var(--line); padding-top:1.4rem; margin-top:1.4rem; }

    /* Emergency */
    .emergency { background:var(--yellow); color:var(--ink); padding:clamp(70px,10vw,120px) 0; position:relative; overflow:hidden; }
    .emergency::after { content:'24/7'; position:absolute; right:-.07em; bottom:-.35em; font-family:var(--serif); font-size:clamp(10rem,24vw,25rem); font-weight:700; color:rgba(17,22,26,.08); letter-spacing:-.07em; pointer-events:none; }
    .emergency-grid { position:relative;z-index:1;display:grid;grid-template-columns:1.1fr .9fr;gap:6vw;align-items:end; }
    .emergency h2 { font-size:clamp(3.5rem,8vw,8.3rem); max-width:8ch; }
    .emergency p { max-width:52ch; }
    .call-number { display:inline-block; margin-top:1.2rem; font-family:var(--serif); font-size:clamp(2rem,4.4vw,4.6rem); line-height:1; text-decoration:none; border-bottom:4px solid var(--ink); }
    .after-hours { margin-top:1rem; font-size:.86rem; font-weight:900; text-transform:uppercase; letter-spacing:.08em; }

    /* Contact */
    .contact { background:var(--ink); color:var(--white); padding:clamp(90px,12vw,160px) 0 60px; }
    .contact-grid { display:grid;grid-template-columns:1.05fr .95fr;gap:8vw; }
    .contact h2 { font-size:clamp(3.4rem,8vw,8rem); max-width:7ch; }
    .contact-lead { color:rgba(255,255,255,.67);font-size:1.15rem;max-width:52ch;margin:1.3rem 0 2rem; }
    .contact-links { display:grid;gap:.75rem; }
    .contact-link { display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1.2rem 0;border-top:1px solid rgba(255,255,255,.18);text-decoration:none; }
    .contact-link:last-child { border-bottom:1px solid rgba(255,255,255,.18); }
    .contact-link span:first-child { font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;color:rgba(255,255,255,.45);font-weight:800; }
    .contact-link strong { font-family:var(--serif);font-size:clamp(1.2rem,2.2vw,1.7rem);font-weight:600; }
    .quote-box { background:var(--white);color:var(--ink);padding:clamp(1.4rem,4vw,2.5rem);box-shadow:var(--shadow); }
    .quote-box h3 { font-family:var(--serif);font-size:2.35rem;letter-spacing:-.04em;margin:.1rem 0 .5rem; }
    .quote-box > p { color:var(--muted);font-size:.9rem;margin:0 0 1.6rem; }
    .field { display:grid;gap:.35rem;margin-bottom:1rem; }
    .field label { font-size:.69rem;font-weight:900;text-transform:uppercase;letter-spacing:.09em; }
    .field input,.field textarea { width:100%;border:0;border-bottom:1px solid rgba(17,22,26,.25);background:transparent;border-radius:0;padding:.78rem .1rem;outline:none; }
    .field input:focus,.field textarea:focus { border-color:var(--yellow); box-shadow:0 2px 0 var(--yellow); }
    .field textarea { min-height:110px;resize:vertical; }
    .form-note { font-size:.74rem;color:#747d82;margin:.8rem 0 0; }
    .form-status { min-height:1.2rem;font-size:.8rem;font-weight:700;margin:.75rem 0 0; }
    .footer { border-top:1px solid rgba(255,255,255,.14); margin-top:6rem; padding-top:1.8rem;display:flex;justify-content:space-between;gap:2rem;color:rgba(255,255,255,.45);font-size:.76rem; }
    .footer a { color:rgba(255,255,255,.7); }

    /* Floating phone */
    .float-phone { position:fixed; z-index:900; right:22px; bottom:22px; text-decoration:none; background:var(--yellow);color:var(--ink);box-shadow:0 14px 40px rgba(0,0,0,.24); padding:.9rem 1rem;display:flex;gap:.7rem;align-items:center;font-weight:950;text-transform:uppercase;letter-spacing:.05em;font-size:.76rem; transition:transform .2s; }
    .float-phone:hover { transform:translateY(-3px); }
    .float-phone i { width:28px;height:28px;background:var(--ink);color:var(--yellow);display:grid;place-items:center;font-style:normal; }

    /* Reveal */
    .reveal { opacity:0; transform:translateY(22px); transition:opacity .75s ease,transform .75s ease; }
    .reveal.visible { opacity:1;transform:none; }

    @media (max-width: 900px) {
      .nav-links,.header-call { display:none; }
      .menu-toggle { display:grid;place-items:center; }
      .nav.open .nav-links { display:flex;position:fixed;inset:68px 0 auto 0;background:var(--ink);padding:2rem;flex-direction:column;align-items:flex-start;border-top:1px solid rgba(255,255,255,.14); }
      .nav.open .nav-links a { font-family:var(--serif);font-size:2rem;text-transform:none;letter-spacing:-.03em;color:white; }
      .hero { min-height:920px; }
      .hero::before { background:linear-gradient(180deg,rgba(17,22,26,.7),rgba(17,22,26,.98) 62%),url('https://www.onehungaplumbers.com/images/onehunga-plumbers.jpg') top right / 100% auto no-repeat; }
      .hero-grid,.intro-grid,.history-grid,.guarantee-grid,.emergency-grid,.contact-grid { grid-template-columns:1fr; }
      .hero-grid { gap:3rem; }
      .hero h1 { font-size:clamp(4rem,19vw,8rem); }
      .signal-grid { grid-template-columns:1fr 1fr; }
      .signal:nth-child(3) { border-top:1px solid rgba(0,0,0,.12); }
      .signal:nth-child(4) { border-top:1px solid rgba(0,0,0,.12); }
      .history-sticky { position:static; }
      .guarantee-visual { min-height:430px; }
      .guarantee-copy { padding:70px 24px; }
      .service-detail-grid { grid-template-columns:1fr;padding-left:0; }
      .service-trigger { grid-template-columns:44px 1fr auto; }
      .service-detail ul { columns:1; }
      .footer { flex-direction:column; }
    }
    @media (max-width: 560px) {
      .wrap { width:min(100% - 28px,1180px); }
      .brand-copy { font-size:.72rem; }
      .hero { min-height:820px;padding-top:110px; }
      .hero h1 { font-size:clamp(3.7rem,20vw,6.7rem); }
      .hero-actions .btn { width:100%; }
      .signal-grid { grid-template-columns:1fr; }
      .signal,.signal:last-child { border-right:0;border-left:0;border-top:1px solid rgba(0,0,0,.12); }
      .signal:first-child { border-top:0; }
      .inline-proof { grid-template-columns:1fr; }
      .proof + .proof { border-left:0;border-top:1px solid var(--line);padding-left:0;padding-top:1rem;margin-top:1rem; }
      .services-head { display:block; }
      .service-trigger { grid-template-columns:32px 1fr auto; gap:.7rem;padding:1.5rem 0; }
      .service-icon { width:36px;height:36px; }
      .timeline-item { padding-left:1.8rem; }
      .call-number { font-size:clamp(1.75rem,10vw,3rem); }
      .float-phone span { display:none; }
      .float-phone { padding:.8rem;right:14px;bottom:14px; }
      .float-phone i { width:34px;height:34px; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior:auto; }
      *,*::before,*::after { animation-duration:.001ms !important;animation-iteration-count:1 !important;transition-duration:.001ms !important; }
      .reveal { opacity:1;transform:none; }
    }
  </style>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header" id="header">
  <nav class="nav" aria-label="Primary navigation">
    <a class="brand" href="#home" aria-label="Onehunga Plumbers home">
      <span class="brand-mark" aria-hidden="true">OP</span>
      <span class="brand-copy"><span>Onehunga</span><span>Plumbers</span></span>
    </a>
    <div class="nav-links" id="navLinks">
      <a href="#home">Home</a>
      <a href="#services">Services</a>
      <a href="#about">About</a>
      <a href="#guarantee">Guarantee</a>
      <a href="#contact">Contact</a>
    </div>
    <a class="btn btn-primary header-call" href="tel:0800866348">Call 0800 8 Onehunga</a>
    <button class="menu-toggle" id="menuToggle" aria-controls="navLinks" aria-expanded="false" aria-label="Open menu">☰</button>
  </nav>
</header>

<main id="main">
  <section class="hero" id="home" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Auckland wide · 24/7</span>
        <h1 class="display" id="hero-title">Fix it.<br><em>Properly.</em></h1>
        <p class="hero-intro">Plumbing, roofing, drainlaying and gasfitting for Auckland homes and businesses—one experienced team, available day or night.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="tel:0800866348">Call now <span class="arrow">→</span></a>
          <a class="btn btn-ghost" href="#services">See services <span class="arrow">↓</span></a>
        </div>
      </div>
      <aside class="hero-aside" aria-label="Service availability">
        <div class="availability">
          <span class="eyebrow">When things go wrong</span>
          <strong>We’re open 24 hours, 7 days.</strong>
          <p>For burst pipes, blocked drains, roof leaks, hot water problems and other plumbing emergencies, call Onehunga Plumbers.</p>
          <div class="hero-tags" aria-label="Services">
            <span>Plumbing</span><span>Roofing</span><span>Drainlaying</span><span>Gasfitting</span>
          </div>
        </div>
      </aside>
    </div>
    <span class="scroll-cue" aria-hidden="true">Scroll to explore</span>
  </section>

