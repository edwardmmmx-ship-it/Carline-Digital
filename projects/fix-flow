<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="robots" content="noindex, nofollow">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fix & Flow Plumbing and Drainage — Auckland</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --navy: #0B1929;
    --navy-mid: #112035;
    --navy-light: #1a3050;
    --aqua: #00B4D8;
    --aqua-dark: #0096B7;
    --aqua-glow: rgba(0,180,216,0.15);
    --white: #FFFFFF;
    --off-white: #F0F4F8;
    --grey: #8A9BB0;
    --grey-light: #C8D5E3;
    --text: #E8EEF4;
    --easing: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--navy);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* ── SCROLLBAR ── */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--navy); }
  ::-webkit-scrollbar-thumb { background: var(--aqua-dark); border-radius: 3px; }

  /* ── TYPOGRAPHY ── */
  .display { font-family: 'Syne', sans-serif; font-weight: 800; }
  .heading { font-family: 'Syne', sans-serif; font-weight: 700; }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    padding: 0 40px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: background 0.4s var(--easing), backdrop-filter 0.4s;
  }
  nav.scrolled {
    background: rgba(11,25,41,0.92);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0,180,216,0.15);
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .nav-logo img {
    height: 36px;
    filter: brightness(0) invert(1);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 36px;
    list-style: none;
  }
  .nav-links a {
    color: var(--grey-light);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.03em;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--white); }
  .nav-cta {
    background: var(--aqua);
    color: var(--navy) !important;
    padding: 10px 22px;
    border-radius: 6px;
    font-weight: 600 !important;
    font-size: 14px !important;
    transition: background 0.2s, transform 0.15s !important;
  }
  .nav-cta:hover { background: var(--aqua-dark) !important; transform: translateY(-1px); }
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 4px;
    background: none;
    border: none;
  }
  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transition: transform 0.3s, opacity 0.3s;
  }
  .mobile-menu {
    display: none;
    position: fixed;
    top: 72px; left: 0; right: 0;
    background: rgba(11,25,41,0.97);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0,180,216,0.15);
    padding: 24px 32px;
    z-index: 999;
    flex-direction: column;
    gap: 20px;
  }
  .mobile-menu.open { display: flex; }
  .mobile-menu a {
    color: var(--grey-light);
    text-decoration: none;
    font-size: 18px;
    font-weight: 500;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: color 0.2s;
  }
  .mobile-menu a:last-child { border-bottom: none; }
  .mobile-menu a:hover { color: var(--aqua); }
  .mobile-call {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--aqua);
    color: var(--navy) !important;
    padding: 14px 20px;
    border-radius: 8px;
    font-weight: 700 !important;
    text-align: center;
    justify-content: center;
    font-size: 17px !important;
    border-bottom: none !important;
  }

  /* ── EMERGENCY BAR ── */
  .emergency-bar {
    position: fixed;
    top: 72px; left: 0; right: 0;
    background: var(--aqua);
    color: var(--navy);
    text-align: center;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    z-index: 998;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    transform: translateY(-100%);
    transition: transform 0.4s var(--easing);
  }
  .emergency-bar.visible { transform: translateY(0); }
  .emergency-bar a { color: var(--navy); font-weight: 700; text-decoration: none; }

  /* ── HERO ── */
  #hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding: 120px 40px 80px;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 60% 50%, rgba(0,180,216,0.08) 0%, transparent 60%),
                linear-gradient(135deg, #0B1929 0%, #112035 50%, #0B1929 100%);
  }
  .pipe-svg {
    position: absolute;
    right: -60px;
    top: 50%;
    transform: translateY(-50%);
    width: 55%;
    opacity: 0.12;
    pointer-events: none;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 700px;
  }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0,180,216,0.12);
    border: 1px solid rgba(0,180,216,0.3);
    color: var(--aqua);
    padding: 7px 16px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .hero-tag::before {
    content: '';
    width: 7px;
    height: 7px;
    background: var(--aqua);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.4); }
  }
  .hero-h1 {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(48px, 7vw, 88px);
    line-height: 1.0;
    letter-spacing: -0.02em;
    color: var(--white);
    margin-bottom: 24px;
  }
  .hero-h1 .accent { color: var(--aqua); }
  .hero-sub {
    font-size: clamp(16px, 2vw, 19px);
    color: var(--grey-light);
    line-height: 1.65;
    margin-bottom: 44px;
    max-width: 520px;
  }
  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 56px;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--aqua);
    color: var(--navy);
    padding: 16px 32px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: 0 4px 24px rgba(0,180,216,0.25);
  }
  .btn-primary:hover {
    background: var(--aqua-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0,180,216,0.35);
  }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    color: var(--white);
    padding: 16px 32px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    border: 1.5px solid rgba(255,255,255,0.2);
    transition: border-color 0.2s, background 0.2s;
  }
  .btn-secondary:hover {
    border-color: var(--aqua);
    background: rgba(0,180,216,0.06);
    color: var(--aqua);
  }
  .hero-stats {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
  }
  .hero-stat {}
  .hero-stat-num {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 32px;
    color: var(--white);
    line-height: 1;
  }
  .hero-stat-num .accent { color: var(--aqua); }
  .hero-stat-label {
    font-size: 13px;
    color: var(--grey);
    margin-top: 4px;
    letter-spacing: 0.02em;
  }
  .hero-stat-divider {
    width: 1px;
    background: rgba(255,255,255,0.1);
    align-self: stretch;
  }

  /* ── TRUST STRIP ── */
  .trust-strip {
    background: var(--navy-mid);
    border-top: 1px solid rgba(0,180,216,0.12);
    border-bottom: 1px solid rgba(0,180,216,0.12);
    padding: 20px 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 48px;
    flex-wrap: wrap;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--grey-light);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }
  .trust-icon {
    color: var(--aqua);
    font-size: 18px;
    flex-shrink: 0;
  }

  /* ── SECTIONS ── */
  section { padding: 100px 40px; }
  .container { max-width: 1200px; margin: 0 auto; }
  .section-eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--aqua);
    margin-bottom: 16px;
  }
  .section-title {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--white);
    margin-bottom: 20px;
  }
  .section-desc {
    font-size: 17px;
    color: var(--grey-light);
    line-height: 1.7;
    max-width: 540px;
  }

  /* ── SERVICES ── */
  #services { background: var(--navy); }
  .services-header {
    display: flex;
    gap: 80px;
    align-items: flex-start;
    margin-bottom: 64px;
    flex-wrap: wrap;
  }
  .services-header-left { flex: 1; min-width: 280px; }
  .services-header-right {
    flex: 1;
    min-width: 280px;
    padding-top: 50px;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: rgba(0,180,216,0.08);
    border: 1px solid rgba(0,180,216,0.12);
    border-radius: 16px;
    overflow: hidden;
  }
  .service-card {
    background: var(--navy-mid);
    padding: 36px 32px;
    cursor: pointer;
    transition: background 0.25s, transform 0.25s;
    position: relative;
    overflow: hidden;
  }
  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0,180,216,0.06) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .service-card:hover::before { opacity: 1; }
  .service-card:hover { background: var(--navy-light); }
  .service-icon {
    width: 48px;
    height: 48px;
    background: rgba(0,180,216,0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    color: var(--aqua);
    font-size: 22px;
    transition: background 0.25s;
  }
  .service-card:hover .service-icon { background: rgba(0,180,216,0.2); }
  .service-name {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 18px;
    color: var(--white);
    margin-bottom: 10px;
  }
  .service-desc {
    font-size: 14px;
    color: var(--grey);
    line-height: 1.6;
  }
  .service-card.featured { grid-column: span 2; }

  /* ── EMERGENCY ── */
  #emergency {
    background: linear-gradient(135deg, var(--aqua) 0%, #0096B7 100%);
    padding: 80px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  #emergency::before {
    content: '24/7';
    position: absolute;
    right: -30px;
    top: 50%;
    transform: translateY(-50%);
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 200px;
    color: rgba(0,0,0,0.08);
    pointer-events: none;
    line-height: 1;
    white-space: nowrap;
  }
  .emergency-content { position: relative; z-index: 1; }
  .emergency-title {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(36px, 5vw, 64px);
    color: var(--navy);
    margin-bottom: 16px;
    line-height: 1.05;
  }
  .emergency-desc {
    font-size: 18px;
    color: rgba(11,25,41,0.75);
    margin-bottom: 36px;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .emergency-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--navy);
    color: var(--white);
    padding: 18px 40px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 18px;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    box-shadow: 0 8px 32px rgba(0,0,0,0.25);
  }
  .emergency-btn:hover {
    background: #0d2040;
    transform: translateY(-2px);
  }

  /* ── HOT WATER ── */
  #hot-water { background: var(--navy-mid); }
  .hw-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .hw-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 12px;
  }
  .hw-img {
    border-radius: 12px;
    overflow: hidden;
    background: var(--navy-light);
  }
  .hw-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s var(--easing);
  }
  .hw-img:hover img { transform: scale(1.04); }
  .hw-img-tall { grid-row: span 2; }
  .hw-img-tall img { height: 360px; }
  .hw-img:not(.hw-img-tall) img { height: 168px; }
  .hw-guarantees {
    margin-top: 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .hw-guarantee {
    background: rgba(0,180,216,0.06);
    border: 1px solid rgba(0,180,216,0.15);
    border-radius: 10px;
    padding: 20px;
  }
  .hw-guarantee-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: var(--aqua);
    margin-bottom: 6px;
  }
  .hw-guarantee-desc {
    font-size: 13px;
    color: var(--grey);
    line-height: 1.5;
  }

  /* ── REVIEWS ── */
  #reviews { background: var(--navy); }
  .reviews-header { margin-bottom: 56px; }
  .stars { color: #F5A623; font-size: 18px; letter-spacing: 2px; margin-bottom: 8px; }
  .google-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 8px 14px;
    border-radius: 6px;
    font-size: 13px;
    color: var(--grey-light);
    margin-top: 12px;
  }
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .review-card {
    background: var(--navy-mid);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 14px;
    padding: 28px;
    position: relative;
    transition: border-color 0.25s, transform 0.25s;
  }
  .review-card:hover {
    border-color: rgba(0,180,216,0.25);
    transform: translateY(-3px);
  }
  .review-stars { color: #F5A623; font-size: 14px; margin-bottom: 14px; }
  .review-text {
    font-size: 15px;
    color: var(--grey-light);
    line-height: 1.7;
    margin-bottom: 20px;
  }
  .reviewer {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .reviewer-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
  }
  .reviewer-name {
    font-weight: 600;
    font-size: 14px;
    color: var(--white);
  }
  .reviewer-time {
    font-size: 12px;
    color: var(--grey);
    margin-top: 2px;
  }
  .review-google-icon {
    position: absolute;
    top: 24px;
    right: 24px;
    opacity: 0.4;
    font-size: 20px;
  }

  /* ── ABOUT ── */
  #about { background: var(--navy-mid); }
  .about-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .about-values {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .about-value {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 20px;
    border-radius: 10px;
    transition: background 0.2s;
  }
  .about-value:hover { background: rgba(0,180,216,0.05); }
  .about-value-icon {
    width: 40px;
    height: 40px;
    background: rgba(0,180,216,0.1);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--aqua);
    font-size: 18px;
    flex-shrink: 0;
  }
  .about-value-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: var(--white);
    margin-bottom: 4px;
  }
  .about-value-desc { font-size: 14px; color: var(--grey); line-height: 1.6; }
  .about-image-block {
    position: relative;
  }
  .about-img-main {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: var(--navy-light);
    aspect-ratio: 4/5;
  }
  .about-img-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .about-badge {
    position: absolute;
    bottom: -20px;
    left: -20px;
    background: var(--aqua);
    color: var(--navy);
    padding: 20px 24px;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,180,216,0.3);
  }
  .about-badge-num {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 36px;
    line-height: 1;
    margin-bottom: 4px;
  }
  .about-badge-label { font-size: 13px; font-weight: 600; }

  /* ── CONTACT ── */
  #contact { background: var(--navy); }
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .contact-info { padding-top: 8px; }
  .contact-detail {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 28px;
  }
  .contact-detail-icon {
    width: 44px;
    height: 44px;
    background: rgba(0,180,216,0.1);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--aqua);
    font-size: 18px;
    flex-shrink: 0;
  }
  .contact-detail-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--grey);
    margin-bottom: 4px;
  }
  .contact-detail-val {
    font-size: 17px;
    font-weight: 600;
    color: var(--white);
  }
  .contact-detail-val a {
    color: var(--white);
    text-decoration: none;
    transition: color 0.2s;
  }
  .contact-detail-val a:hover { color: var(--aqua); }
  .contact-form-wrap {
    background: var(--navy-mid);
    border: 1px solid rgba(0,180,216,0.12);
    border-radius: 16px;
    padding: 40px;
  }
  .form-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 22px;
    color: var(--white);
    margin-bottom: 24px;
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-group { margin-bottom: 18px; }
  .form-group label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--grey-light);
    margin-bottom: 8px;
    letter-spacing: 0.02em;
  }
  .form-group input,
  .form-group textarea,
  .form-group select {
    width: 100%;
    background: rgba(255,255,255,0.04);
    border: 1.5px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    padding: 13px 16px;
    color: var(--white);
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus {
    border-color: var(--aqua);
